<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="?attr/tarotZodiacSelected" />
            <corners android:radius="@dimen/dp_16" />
            <stroke
                android:width="@dimen/dp_2"
                android:color="@color/tarot_gold" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="?attr/tarotZodiacTile" />
            <corners android:radius="@dimen/dp_16" />
            <stroke
                android:width="@dimen/dp_0_5"
                android:color="?attr/tarotZodiacBorder" />
        </shape>
    </item>
</selector>
