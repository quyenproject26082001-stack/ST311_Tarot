<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/tarot_pale_gold" />
            <corners android:radius="16dp" />
            <stroke
                android:width="2dp"
                android:color="@color/tarot_gold" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="?attr/tarotPaper" />
            <corners android:radius="16dp" />
            <stroke
                android:width="0.5dp"
                android:color="#FFF3D7" />
        </shape>
    </item>
</selector>
