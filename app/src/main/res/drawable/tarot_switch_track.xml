<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <size
                android:width="32dp"
                android:height="20dp" />
            <corners android:radius="10dp" />
            <solid android:color="@color/tarot_green" />
        </shape>
    </item>
    <item>
        <shape>
            <size
                android:width="32dp"
                android:height="20dp" />
            <corners android:radius="10dp" />
            <solid android:color="@color/tarot_disabled" />
        </shape>
    </item>
</selector>
