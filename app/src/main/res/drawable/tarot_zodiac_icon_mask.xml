<?xml version="1.0" encoding="utf-8"?>
<!-- The source disc includes pixels blended with its white background.
     Clip 2 source pixels inside that disc: (4,3)-(48,47) at the 2x scale.
     Inset only the outline; keep the artwork and glyph at their original scale.
     A fully rounded rectangle remains clip-compatible on API 24 at odd pixel densities. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="@dimen/dp_2"
    android:insetTop="@dimen/dp_1_5"
    android:insetRight="@dimen/dp_2"
    android:insetBottom="@dimen/dp_2_5">
    <shape android:shape="rectangle">
        <solid android:color="?attr/tarotPaper" />
        <corners android:radius="@dimen/dp_100" />
    </shape>
</inset>
