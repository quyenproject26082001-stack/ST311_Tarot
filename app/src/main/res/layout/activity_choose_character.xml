<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.choose_character.ChooseCharacterActivity"
    tools:visibility="visible">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_app"
        tools:visibility="visible"
        tools:src="@drawable/img_intro_1" />

    <!--    layoutActionBar-->
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar"
            tools:visibility="visible" />
    </FrameLayout>

<!--    &lt;!&ndash;    native_ads&ndash;&gt;-->
    <FrameLayout
        android:id="@+id/native_ads"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar"
        tools:visibility="visible">

        <include layout="@layout/ads_native_collap_banner_shimmer" tools:visibility="visible" />
    </FrameLayout>

    <!-- rcvMyAlbum -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvCharacter"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_marginTop="@dimen/dp_14"
        android:translationY="@dimen/dp_0"
        android:layout_marginBottom="@dimen/dp_0"
        android:paddingHorizontal="@dimen/dp_16"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/native_ads"
        app:spanCount="2"
        tools:listitem="@layout/item_choose_avatar"
        tools:visibility="visible"
        tools:itemCount="6"
        tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager" />


<!--    &lt;!&ndash;    flNativeCollab&ndash;&gt;-->
    <FrameLayout
        android:id="@+id/flNativeCollab"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:visibility="visible">

    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
