<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.tarot.card.meaning.ui.SettingsActivity"
    tools:visibility="visible">

    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_app"
        tools:visibility="visible"
        tools:src="@drawable/bg_app" />

    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar"
            tools:visibility="visible" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_15"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/btnLang"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56"
            android:background="@drawable/bg_setting_item_v2"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_16"
            tools:visibility="visible">

            <ImageView
                android:layout_width="@dimen/dp_24"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                android:src="@drawable/ic_lang_set"
                android:tint="@color/figma_primary"
                tools:visibility="visible"
                tools:src="@drawable/ic_lang_set" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12"
                android:fontFamily="@font/baloo_2_bold"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="@string/language"
                android:textColor="@color/figma_primary"
                android:textSize="@dimen/sp_18"
                tools:visibility="visible"
                tools:text="@string/language" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnRate"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56"
            android:layout_marginTop="@dimen/dp_8"
            android:background="@drawable/bg_setting_item_v2"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_16"
            tools:visibility="visible">

            <ImageView
                android:layout_width="@dimen/dp_24"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                android:src="@drawable/ic_rate_set"
                android:tint="@color/figma_primary"
                tools:visibility="visible"
                tools:src="@drawable/ic_rate_set" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12"
                android:fontFamily="@font/baloo_2_bold"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="@string/rate_us"
                android:textColor="@color/figma_primary"
                android:textSize="@dimen/sp_18"
                tools:visibility="visible"
                tools:text="@string/rate_us" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnShareApp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56"
            android:layout_marginTop="@dimen/dp_8"
            android:background="@drawable/bg_setting_item_v2"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_16"
            tools:visibility="visible">

            <ImageView
                android:layout_width="@dimen/dp_24"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                android:src="@drawable/ic_share_set"
                android:tint="@color/figma_primary"
                tools:visibility="visible"
                tools:src="@drawable/ic_share_set" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12"
                android:fontFamily="@font/baloo_2_bold"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="@string/share_app"
                android:textColor="@color/figma_primary"
                android:textSize="@dimen/sp_18"
                tools:visibility="visible"
                tools:text="@string/share_app" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnPolicy"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56"
            android:layout_marginTop="@dimen/dp_8"
            android:background="@drawable/bg_setting_item_v2"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_16"
            tools:visibility="visible">

            <ImageView
                android:layout_width="@dimen/dp_24"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                android:src="@drawable/ic_policy_set"
                android:tint="@color/figma_primary"
                tools:visibility="visible"
                tools:src="@drawable/ic_policy_set" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12"
                android:fontFamily="@font/baloo_2_bold"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="@string/privacy_policy"
                android:textColor="@color/figma_primary"
                android:textSize="@dimen/sp_18"
                tools:visibility="visible"
                tools:text="@string/privacy_policy" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
