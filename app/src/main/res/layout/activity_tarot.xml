<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/tarotPaper">
    <ImageView
        android:id="@+id/pageBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_app"
        android:scaleType="fitXY"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:id="@+id/page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar"
            android:theme="@style/TarotActionBarOverlay"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tarot_header_height" />
        <FrameLayout
            android:id="@+id/screenHost"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <LinearLayout
            android:id="@+id/bottomTabs"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:paddingHorizontal="16dp"
            android:background="?attr/tarotPaper"
            android:elevation="4dp"
            android:orientation="horizontal" />
    </LinearLayout>
</FrameLayout>
