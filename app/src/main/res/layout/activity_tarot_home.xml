<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp_minus_3"
    android:orientation="vertical"
    xmlns:tools="http://schemas.android.com/tools"
    tools:visibility="visible"
    tools:theme="@style/TarotThemeLight">
    <TextView
        android:id="@+id/greeting"
        style="@style/TarotTextHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/tarot_nunito_medium"
        tools:visibility="visible"
        tools:text="Hello, Seraphina!" />
    <TextView
        style="@style/TarotTextBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_minus_1_5"
        android:textSize="@dimen/sp_13"
        android:lineHeight="@dimen/sp_18"
        android:text="@string/tarot_discover"
        tools:visibility="visible"
        tools:text="@string/tarot_discover" />
    <FrameLayout
        android:id="@+id/horoscope"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_200"
        android:layout_marginTop="@dimen/dp_13_5"
        android:background="@drawable/tarot_bg_horoscope"
        android:clipToOutline="true"
        android:clickable="true"
        android:focusable="true"
        tools:visibility="visible">
        <ImageView
            android:layout_width="@dimen/dp_102"
            android:layout_height="@dimen/dp_62"
            android:layout_gravity="bottom|start"
            android:src="@drawable/tarot_horoscope_sun"
            android:scaleType="fitXY"
            android:importantForAccessibility="no"
            tools:visibility="visible"
            tools:src="@drawable/tarot_horoscope_sun" />
        <ImageView
            android:layout_width="@dimen/dp_39"
            android:layout_height="@dimen/dp_38"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/dp_4"
            android:src="@drawable/tarot_horoscope_moon"
            android:scaleType="fitXY"
            android:importantForAccessibility="no"
            tools:visibility="visible"
            tools:src="@drawable/tarot_horoscope_moon" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/dp_12"
            android:orientation="vertical"
            tools:visibility="visible">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_23"
                android:paddingHorizontal="@dimen/dp_6"
                android:gravity="center_vertical"
                android:background="@drawable/tarot_bg_outline"
                android:orientation="horizontal"
                tools:visibility="visible">
                <ImageView
                    android:id="@+id/zodiacIcon"
                    style="@style/TarotZodiacBadgeIcon"
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:importantForAccessibility="no"
                    tools:visibility="visible"
                    tools:src="@drawable/ic_aries" />
                <TextView
                    android:id="@+id/zodiacName"
                    style="@style/TarotText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_5"
                    android:textColor="@color/tarot_gold"
                    android:textSize="@dimen/sp_12"
                    tools:visibility="visible"
                    tools:text="Aries" />
            </LinearLayout>
            <TextView
                style="@style/TarotTextHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:text="@string/tarot_weekly_horoscope"
                tools:visibility="visible"
                tools:text="@string/tarot_weekly_horoscope" />
            <TextView
                android:id="@+id/horoscopeSummary"
                style="@style/TarotTextBody"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/dp_8"
                android:textStyle="italic"
                android:text="@string/tarot_home_horoscope_preview"
                tools:visibility="visible"
                tools:text="@string/tarot_home_horoscope_preview" />
            <TextView
                style="@style/TarotTextHeading"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_32"
                android:gravity="end|center_vertical"
                android:textSize="@dimen/sp_14"
                android:text="@string/tarot_view_horoscope"
                tools:visibility="visible"
                tools:text="@string/tarot_view_horoscope" />
        </LinearLayout>
    </FrameLayout>
    <TextView
        style="@style/TarotTextHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:fontFamily="@font/tarot_nunito_semibold"
        android:text="@string/tarot_quick_actions"
        tools:visibility="visible"
        tools:text="@string/tarot_quick_actions" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/quickActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6_5"
        tools:visibility="visible">
        <include
            android:id="@+id/actionDaily"
            layout="@layout/item_tarot_action"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_0"
            android:layout_marginEnd="@dimen/dp_12"
            app:layout_constraintDimensionRatio="H,99:122.5"
            app:layout_constraintEnd_toStartOf="@id/actionWeekly"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />
        <include
            android:id="@+id/actionWeekly"
            layout="@layout/item_tarot_action"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_0"
            android:layout_marginEnd="@dimen/dp_12"
            app:layout_constraintDimensionRatio="H,99:122.5"
            app:layout_constraintEnd_toStartOf="@id/actionCeltic"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/actionDaily"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />
        <include
            android:id="@+id/actionCeltic"
            layout="@layout/item_tarot_action"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_0"
            app:layout_constraintDimensionRatio="H,99:122.5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/actionWeekly"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        style="@style/TarotTextHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_15"
        android:text="@string/tarot_recent"
        tools:visibility="visible"
        tools:text="@string/tarot_recent" />
    <LinearLayout
        android:id="@+id/recentReadings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:orientation="vertical"
        tools:visibility="visible" />
    <LinearLayout
        android:id="@+id/emptyRecent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:visibility="visible">
        <ImageView
            android:id="@+id/emptyRecentArt"
            android:layout_width="@dimen/dp_124"
            android:layout_height="@dimen/dp_108"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/dp_7_5"
            android:translationX="@dimen/dp_3"
            android:background="?attr/tarotEmptyReadingGlow"
            android:src="?attr/tarotEmptyReadingArt"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            tools:visibility="visible"
            tools:src="@drawable/tarot_empty_history" />
        <TextView
            style="@style/TarotText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_13"
            android:gravity="center"
            android:textSize="@dimen/sp_12"
            android:text="@string/tarot_no_recent"
            tools:visibility="visible"
            tools:text="@string/tarot_no_recent" />
    </LinearLayout>
</LinearLayout>
