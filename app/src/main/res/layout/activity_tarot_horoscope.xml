<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp_11"
    android:orientation="vertical"
    xmlns:tools="http://schemas.android.com/tools"
    tools:visibility="visible"
    tools:theme="@style/TarotThemeLight">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_12"
        android:orientation="horizontal"
        tools:visibility="visible">
        <ImageView
            android:id="@+id/zodiacIcon"
            style="@style/TarotHoroscopeZodiacIcon"
            android:layout_width="@dimen/dp_66"
            android:layout_height="@dimen/dp_66"
            android:importantForAccessibility="no"
            tools:visibility="visible"
            tools:src="@drawable/ic_aries" />
        <LinearLayout
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_6"
            android:orientation="vertical"
            tools:visibility="visible">
            <TextView
                android:id="@+id/zodiacName"
                style="@style/TarotText"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_22"
                android:paddingHorizontal="@dimen/dp_10"
                android:gravity="center"
                android:background="@drawable/tarot_bg_zodiac_label"
                tools:visibility="visible"
                tools:text="Aries" />
            <TextView
                android:id="@+id/weekPeriod"
                style="@style/TarotText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_6"
                android:lineHeight="@dimen/sp_20"
                android:textSize="@dimen/sp_12"
                tools:visibility="visible"
                tools:text="Oct 18 - Oct 24, 2026" />
        </LinearLayout>
    </LinearLayout>
    <include android:id="@+id/pair" layout="@layout/tarot_pair" tools:visibility="visible" />
</LinearLayout>
