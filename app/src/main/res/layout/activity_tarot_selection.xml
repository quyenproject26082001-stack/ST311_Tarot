<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    xmlns:tools="http://schemas.android.com/tools"
    tools:visibility="visible"
    tools:theme="@style/TarotThemeLight">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingTop="@dimen/dp_8"
        android:orientation="vertical"
        tools:visibility="visible">
        <TextView
            style="@style/TarotTextHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sp_16"
            android:fontFamily="@font/tarot_nunito_medium"
            android:lineHeight="@dimen/sp_20"
            android:text="@string/tarot_select_card"
            tools:visibility="visible"
            tools:text="@string/tarot_select_card" />
        <TextView
            android:id="@+id/selectDescription"
            style="@style/TarotTextBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginBottom="@dimen/dp_10"
            android:textSize="@dimen/sp_12"
            android:lineHeight="@dimen/sp_16"
            tools:visibility="visible"
            tools:text="Please choose 1 card for your reading." />
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0_5"
        android:background="@color/tarot_gold"
        tools:visibility="visible" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginBottom="@dimen/dp_10"
        android:padding="@dimen/dp_4"
        android:background="@drawable/tarot_list_selection_segment"
        android:orientation="horizontal"
        tools:visibility="visible">
        <TextView
            android:id="@+id/scrollMode"
            style="@style/TarotText"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="@dimen/sp_16"
            android:text="@string/tarot_scroll"
            tools:visibility="visible"
            tools:text="@string/tarot_scroll" />
        <TextView
            android:id="@+id/classicMode"
            style="@style/TarotText"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="@dimen/sp_16"
            android:text="@string/tarot_classic"
            tools:visibility="visible"
            tools:text="@string/tarot_classic" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/deck"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_14"
        android:paddingBottom="@dimen/dp_4"
        android:clipToPadding="false"
        tools:visibility="visible"
        tools:listitem="@layout/item_tarot_deck"
        tools:itemCount="24"
        tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        tools:spanCount="6" />
    <LinearLayout
        android:id="@+id/selectionFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingTop="@dimen/dp_4"
        android:paddingBottom="@dimen/dp_6"
        android:gravity="center_vertical"
        android:background="?attr/tarotPaper"
        android:orientation="horizontal"
        tools:visibility="visible">
        <TextView
            android:id="@+id/selectedCount"
            style="@style/TarotText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:textSize="@dimen/sp_11"
            android:lineHeight="@dimen/sp_14"
            android:accessibilityLiveRegion="polite"
            tools:visibility="visible"
            tools:text="1 of 1 cards selected" />
    </LinearLayout>
</LinearLayout>
