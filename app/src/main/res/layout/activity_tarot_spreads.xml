<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/dp_3"
    android:orientation="vertical"
    xmlns:tools="http://schemas.android.com/tools"
    tools:visibility="visible"
    tools:theme="@style/TarotThemeLight">
    <TextView
        style="@style/TarotText"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_20"
        android:text="@string/tarot_choose_spread"
        android:textSize="@dimen/sp_16"
        android:lineHeight="@dimen/sp_20"
        android:textStyle="italic"
        tools:visibility="visible"
        tools:text="@string/tarot_choose_spread" />
    <TextView
        style="@style/TarotText"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_14"
        android:layout_marginBottom="@dimen/dp_17"
        android:text="@string/tarot_spread_description"
        android:textSize="@dimen/sp_11"
        android:lineHeight="@dimen/sp_14"
        android:textStyle="italic"
        tools:visibility="visible"
        tools:text="@string/tarot_spread_description" />
    <LinearLayout
        android:id="@+id/spreadItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:visibility="visible" />
</LinearLayout>
