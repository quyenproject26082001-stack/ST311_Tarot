<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:visibility="gone"
    tools:visibility="visible">

    <RelativeLayout
        android:id="@+id/ad_unit_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_native"
        android:orientation="vertical"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:visibility="visible">
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="25dip"
                android:paddingTop="8dip"
                android:paddingEnd="8dip"
                android:paddingBottom="8dip"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/ad_app_icon"
                    android:layout_width="35dip"
                    android:layout_height="35dip"
                    android:adjustViewBounds="true"
                    tools:visibility="visible"
                    tools:src="@drawable/ic_aries"/>
                <TextView
                    style="@style/AppTheme.Ads"
                    android:layout_marginStart="5dip"
                    android:backgroundTint="@color/native_bg_btn"
                    tools:visibility="visible"
                    tools:text="Ad" />
                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dip"

                    android:orientation="vertical"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/ad_headline"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text=""
                        android:textColor="@color/black"
                        android:textSize="@dimen/sp_12"
                        android:textStyle="bold"
                        tools:visibility="visible"
                        tools:text="Discover your daily inspiration" />


                    <TextView
                        android:id="@+id/ad_advertiser"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_0"
                        android:layout_weight="1"
                        android:gravity="bottom"
                        android:lines="1"
                        android:textColor="@color/black"
                        android:textSize="@dimen/sp_10"
                        tools:visibility="visible"
                        tools:text="Sponsored content" />


                </LinearLayout>

            </LinearLayout>
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                tools:visibility="visible">
                <TextView
                    android:layout_marginHorizontal="@dimen/dp_20"
                    android:id="@+id/ad_body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="@dimen/sp_12"
                    tools:visibility="visible"
                    tools:text="Explore fresh ideas and find something that inspires you." />

            </LinearLayout>
            <com.google.android.gms.ads.nativead.MediaView
                android:id="@+id/ad_media"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/dp_120"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/dp_5"
                android:layout_weight="1"
                tools:ignore="InefficientWeight"
                tools:visibility="visible"
                tools:background="#F6E9B6" />
            <ImageView
                android:id="@+id/ad_call_to_action"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/dp_50"
                android:layout_marginHorizontal="@dimen/dp_20"
                android:layout_marginVertical="@dimen/dp_10"
                android:gravity="center"
                android:textColor="@color/native_text_color_btn"
                android:textSize="@dimen/sp_12"
                android:textStyle="bold"
                tools:visibility="visible"
                tools:src="@drawable/ic_sw_on" />
        </LinearLayout>


    </RelativeLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
