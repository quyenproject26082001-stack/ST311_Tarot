<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:visibility="gone"
    xmlns:tools="http://schemas.android.com/tools"
    tools:visibility="visible">

    <RelativeLayout
        android:id="@+id/ad_unit_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_native"
        android:orientation="vertical"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_5"
                android:layout_marginTop="@dimen/dp_5"
                android:layout_marginBottom="@dimen/dp_5"
                android:orientation="horizontal"
                tools:visibility="visible">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/dp_3"
                    android:layout_marginEnd="@dimen/dp_5"
                    tools:visibility="visible">

                    <com.google.android.gms.ads.nativead.MediaView
                        android:id="@+id/ad_media"
                        android:layout_width="@dimen/dp_120"
                        android:layout_height="@dimen/dp_120"
                        tools:visibility="visible"
                        tools:background="#F6E9B6" />
                    <TextView
                        style="@style/AppTheme.Ads"
                        android:layout_gravity="end"
                        android:background="@color/native_bg_btn"
                        android:elevation="@dimen/dp_1"
                        tools:visibility="visible"
                        tools:text="Ad" />
                </FrameLayout>


                <LinearLayout
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/ad_advertiser"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="bottom"
                        android:maxLines="2"
                        android:textColor="@color/native_text_color"
                        android:textSize="@dimen/sp_12"
                        android:textStyle="bold"
                        tools:visibility="visible"
                        tools:text="Sponsored content" />

                    <TextView
                        android:id="@+id/ad_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/native_text_color"
                        android:textSize="@dimen/sp_12"
                        tools:visibility="visible"
                        tools:text="Explore fresh ideas and find something that inspires you." />
                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_5"
                android:layout_marginBottom="@dimen/dp_4"
                android:orientation="horizontal"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/ad_app_icon"
                    android:layout_width="@dimen/dp_40"
                    android:layout_height="@dimen/dp_40"
                    android:adjustViewBounds="true"
                    tools:visibility="visible"
                    tools:src="@drawable/ic_aries" />

                <TextView
                    android:id="@+id/ad_headline"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/dp_5"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:text=""
                    android:textColor="@color/native_text_color"
                    android:textSize="@dimen/sp_11"
                    tools:visibility="visible"
                    tools:text="Discover your daily inspiration" />

                <ImageView
                    android:id="@+id/ad_call_to_action"
                    android:layout_width="@dimen/dp_120"
                    android:layout_height="@dimen/dp_40"
                    android:gravity="center"
                    android:textColor="@color/native_text_color_btn"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold"
                    tools:visibility="visible"
                    tools:src="@drawable/ic_sw_on" />
            </LinearLayout>

        </LinearLayout>


    </RelativeLayout>


</com.facebook.shimmer.ShimmerFrameLayout>
