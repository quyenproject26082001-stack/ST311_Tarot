<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:visibility="gone"
    tools:visibility="visible"
    tools:background="#F6E9B6">

    <RelativeLayout
        android:id="@+id/ad_unit_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_native"
        android:orientation="vertical"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="25dip"
                android:paddingTop="10dip"
                android:paddingEnd="5dip"
                android:paddingBottom="10dip"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/ad_app_icon"
                    android:layout_width="35dip"
                    android:layout_height="35dip"
                    android:adjustViewBounds="true"
                    tools:visibility="visible"
                    tools:src="@drawable/ic_aries" />
                <TextView
                    style="@style/AppTheme.Ads"
                    android:layout_marginStart="5dip"
                    android:background="@color/native_bg_btn"
                    tools:visibility="visible"
                    tools:text="Ad" />

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_marginStart="5dip"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/ad_headline"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text=""
                        android:textColor="@color/native_text_color"
                        android:textSize="@dimen/sp_12"
                        android:textStyle="bold"
                        tools:visibility="visible"
                        tools:text="Discover your daily inspiration" />


                    <TextView
                        android:id="@+id/ad_advertiser"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_0"
                        android:layout_weight="1"
                        android:gravity="bottom"
                        android:lines="1"
                        android:textColor="@color/native_text_color"
                        android:textSize="@dimen/sp_10"
                        tools:visibility="visible"
                        tools:text="Sponsored content" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                tools:visibility="visible">
                <TextView
                    android:paddingBottom="@dimen/dp_10"
                    android:layout_marginHorizontal="@dimen/dp_20"
                    android:id="@+id/ad_body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/native_text_color"
                    android:textSize="@dimen/sp_12"
                    tools:visibility="visible"
                    tools:text="Explore fresh ideas and find something that inspires you." />

            </LinearLayout>
            <androidx.appcompat.widget.AppCompatButton
                android:layout_marginBottom="@dimen/dp_5"
                android:id="@+id/ad_call_to_action"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/dp_40"
                android:layout_marginHorizontal="@dimen/dp_20"
                android:layout_marginTop="@dimen/dp_10"
                android:background="@drawable/bg_btn_ads_native"
                android:gravity="center"
                android:text="Install"
                android:textColor="@color/native_text_color_btn"
                android:textSize="@dimen/sp_12"
                android:textStyle="bold"
                tools:visibility="visible"
                tools:text="Install"/>
        </LinearLayout>


    </RelativeLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
