<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/dp_16"
    android:background="?attr/tarotGuidancePanelBackground"
    android:orientation="vertical"
    xmlns:tools="http://schemas.android.com/tools"
    tools:visibility="visible"
    tools:theme="@style/TarotThemeLight">
    <com.tarot.card.meaning.tarot.TarotIcon
        android:id="@+id/close"
        style="@style/TarotIconButton"
        android:padding="@dimen/dp_12"
        android:translationX="@dimen/dp_10"
        android:layout_gravity="end"
        app:tarotIconName="close"
        app:tarotIconColor="?attr/tarotInk"
        android:contentDescription="@string/tarot_close"
        tools:visibility="visible"
        tools:src="@drawable/tarot_ic_close" />
    <ImageView
        android:id="@+id/shuffleArt"
        android:layout_width="@dimen/dp_183"
        android:layout_height="@dimen/dp_146"
        android:translationX="@dimen/dp_minus_1_5"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/dp_40"
        android:layout_marginBottom="@dimen/dp_47"
        android:src="?attr/tarotGuidanceArt"
        android:scaleType="fitCenter"
        android:scaleX="?attr/tarotGuidanceArtScale"
        android:scaleY="?attr/tarotGuidanceArtScale"
        android:contentDescription="Shuffle cards"
        tools:visibility="visible"
        tools:src="@drawable/tarot_guidance_art" />
    <TextView
        style="@style/TarotTextBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:justificationMode="inter_word"
        android:lineHeight="@dimen/sp_16"
        android:text="@string/tarot_guidance_design"
        tools:visibility="visible"
        tools:text="@string/tarot_guidance_design" />
    <TextView
        android:id="@+id/continueReading"
        style="@style/TarotButton"
        android:layout_marginTop="@dimen/dp_20"
        android:background="@drawable/tarot_bg_guidance_continue"
        android:text="@string/tarot_continue"
        tools:visibility="visible"
        tools:text="@string/tarot_continue" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_42"
        android:layout_marginTop="@dimen/dp_12"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        tools:visibility="visible">
        <TextView
            style="@style/TarotText"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tarot_show_guidance"
            tools:visibility="visible"
            tools:text="@string/tarot_show_guidance" />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/showGuidance"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_20"
            android:minWidth="@dimen/dp_0"
            android:minHeight="@dimen/dp_0"
            android:padding="@dimen/dp_0"
            android:background="@drawable/tarot_guidance_switch"
            android:thumb="@null"
            app:track="@null"
            app:switchMinWidth="@dimen/dp_0"
            app:showText="false"
            app:thumbTint="@null"
            app:trackTint="@null"
            android:contentDescription="@string/tarot_show_guidance"
            tools:visibility="visible"
            tools:text="Show guidance"
            tools:checked="true" />
    </LinearLayout>
</LinearLayout>
