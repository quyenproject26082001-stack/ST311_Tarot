<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:theme="@style/TarotThemeLight"
    tools:visibility="visible">
    <TextView
        android:id="@+id/starDescription"
        style="@style/TarotText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_10"
        android:text="@string/tarot_star_description"
        android:textColor="?attr/tarotMuted"
        android:textSize="@dimen/sp_12"
        tools:text="@string/tarot_star_description"
        tools:visibility="visible" />
    <include
        android:id="@+id/zodiacGrid"
        layout="@layout/tarot_zodiac_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_18"
        tools:visibility="visible" />
    <LinearLayout
        android:id="@+id/birthdayBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_18"
        android:orientation="vertical"
        tools:visibility="visible">
        <TextView
            android:id="@+id/birthdayDescription"
            style="@style/TarotText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_10"
            android:textColor="?attr/tarotMuted"
            android:textSize="@dimen/sp_12"
            android:visibility="gone"
            tools:text="Choose a birthday for Aries (21/03 - 19/04)."
            tools:visibility="visible" />
        <com.tarot.card.meaning.tarot.BirthdayWheel
            android:id="@+id/birthdayPicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
    <TextView
        android:id="@+id/submit"
        style="@style/TarotButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_46"
        android:text="@string/tarot_submit"
        tools:text="@string/tarot_submit"
        tools:visibility="visible" />
</LinearLayout>
