<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        style="@style/TarotText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:textSize="11sp"
        android:text="@string/tarot_personal_information" />
    <LinearLayout
        android:id="@+id/personalGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/tarot_bg_panel"
        android:clipToOutline="true"
        android:orientation="vertical" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/tarot_bg_panel"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            style="@style/TarotText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tarot_theme" />
        <LinearLayout
            android:layout_width="144dp"
            android:layout_height="36dp"
            android:padding="3dp"
            android:background="@drawable/tarot_bg_input"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/lightTheme"
                android:drawableStart="@drawable/tarot_ic_light_small"
                android:drawablePadding="3dp"
                android:drawableTint="@color/tarot_theme_choice"
                android:paddingHorizontal="6dp"
                style="@style/TarotText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="12sp"
                android:text="@string/tarot_light" />
            <TextView
                android:id="@+id/darkTheme"
                android:drawableStart="@drawable/tarot_ic_dark_small"
                android:drawablePadding="3dp"
                android:drawableTint="@color/tarot_theme_choice"
                android:paddingHorizontal="6dp"
                style="@style/TarotText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="12sp"
                android:text="@string/tarot_dark" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/tarot_bg_panel"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            style="@style/TarotText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tarot_show_guidance" />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/guidanceToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumb="@drawable/tarot_switch_thumb"
            app:track="@drawable/tarot_switch_track"
            app:switchMinWidth="32dp"
            app:thumbTint="#FFFFFF"
            app:trackTint="@color/tarot_switch_track"
            android:contentDescription="@string/tarot_show_guidance" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/tarot_bg_panel"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                style="@style/TarotText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tarot_reverse_chance" />
            <com.aaa.bbb.ccc.tarot.TarotIcon
                android:id="@+id/reverseInfo"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:tarotIconName="info"
                app:tarotIconColor="?attr/tarotMuted"
                android:contentDescription="@string/tarot_reverse_chance" />
            <TextView
                android:id="@+id/reversePercent"
                style="@style/TarotText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textSize="12sp" />
        </LinearLayout>
        <SeekBar
            android:id="@+id/reverseChance"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:max="100"
            android:progressDrawable="@drawable/tarot_seek_track"
            android:thumb="@drawable/tarot_seek_thumb"
            android:maxHeight="8dp"
            android:minHeight="8dp"
            android:progressTint="@color/tarot_green"
            android:thumbTint="@color/tarot_green"
            android:progressBackgroundTint="@color/tarot_disabled"
            android:paddingHorizontal="0dp"
            android:contentDescription="@string/tarot_reverse_chance" />
    </LinearLayout>
    <TextView
        style="@style/TarotText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingStart="4dp"
        android:textSize="11sp"
        android:text="@string/tarot_additional_options" />
    <LinearLayout
        android:id="@+id/additionalGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/tarot_bg_panel"
        android:clipToOutline="true"
        android:orientation="vertical" />
</LinearLayout>
