<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dp_4"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:visibility="visible">

    <FrameLayout
        android:id="@+id/root"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:clipChildren="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/dp_2"
            app:cardCornerRadius="@dimen/dp_12"
            app:strokeColor="@color/figma_primary"
            app:strokeWidth="@dimen/dp_2"
            tools:visibility="visible">



                    <ImageView
                        android:id="@+id/imvImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        tools:src="@color/red_BA"
                        tools:visibility="visible" />

                    <FrameLayout
                        android:id="@+id/frameCover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#80000000"
                        tools:visibility="visible" />

                    <ImageView
                        android:id="@+id/btnDelete"
                        android:layout_width="@dimen/dp_32"
                        android:layout_height="@dimen/dp_32"
                        android:layout_gravity="end|top"
                        android:layout_margin="@dimen/dp_4"
                        android:src="@drawable/ic_delete_item"
                        tools:visibility="visible"
                        tools:src="@drawable/ic_delete_item" />

                    <!--btnEdit-->
                    <ImageView
                        android:id="@+id/btnEdit"
                        android:layout_width="@dimen/dp_32"
                        android:layout_height="@dimen/dp_32"
                        android:layout_gravity="start|top"
                        android:layout_margin="@dimen/dp_4"
                        android:src="@drawable/ic_edit"
                        android:visibility="visible"
                        tools:visibility="visible"
                        tools:src="@drawable/ic_edit" />

                    <!--btnSelect-->
                    <ImageView
                        android:id="@+id/btnSelect"
                        android:layout_width="@dimen/dp_32"
                        android:layout_height="@dimen/dp_32"
                        android:layout_gravity="end|top"
                        android:layout_margin="@dimen/dp_4"
                        android:src="@drawable/ic_not_select"
                        android:visibility="gone"
                        tools:visibility="visible"
                        tools:src="@drawable/ic_not_select" />
                </com.google.android.material.card.MaterialCardView>
        <!--btnDelete-->


    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
