<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_108"
    android:layout_marginHorizontal="@dimen/dp_8"
    android:layout_marginBottom="@dimen/dp_8"
    android:background="@drawable/tarot_bg_panel"
    android:paddingStart="@dimen/dp_18"
    android:paddingEnd="@dimen/dp_12"
    android:paddingVertical="@dimen/dp_4"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:clickable="true"
    android:focusable="true"
    xmlns:tools="http://schemas.android.com/tools"
    tools:visibility="visible"
    tools:theme="@style/TarotThemeLight">
    <ImageView
        android:id="@+id/cardImage"
        android:layout_width="@dimen/dp_56"
        android:layout_height="@dimen/dp_100"
        android:scaleType="fitCenter"
        tools:visibility="visible"
        tools:src="@drawable/tarot_deck_back" />
    <LinearLayout
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/dp_12"
        android:orientation="vertical"
        tools:visibility="visible">
        <TextView
            android:id="@+id/cardTitle"
            style="@style/TarotTextHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/tarot_nunito_semibold"
            android:lineHeight="@dimen/sp_22"
            android:maxLines="1"
            android:ellipsize="end"
            tools:visibility="visible"
            tools:text="Page of Wands" />
        <TextView
            android:id="@+id/cardMeaning"
            style="@style/TarotText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:maxLines="3"
            android:ellipsize="end"
            android:lineHeight="@dimen/sp_20"
            android:textSize="@dimen/sp_12"
            tools:visibility="visible"
            tools:text="New ideas, curiosity and the courage to begin." />
    </LinearLayout>
</LinearLayout>
