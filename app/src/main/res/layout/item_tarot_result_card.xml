<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp">
    <TextView
        android:id="@+id/positionTitle"
        style="@style/TarotTextHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/cardImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter" />
    <TextView
        android:id="@+id/cardTitle"
        style="@style/TarotText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />
    <TextView
        android:id="@+id/answerLabel"
        style="@style/TarotTextBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="14sp"
        android:text="@string/tarot_answer_label"
        android:visibility="gone" />
    <TextView
        android:id="@+id/meaningNotice"
        style="@style/TarotTextBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="11sp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/answer"
        style="@style/TarotTextHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textSize="14sp"
        android:justificationMode="inter_word"
        android:lineHeight="21sp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/interpretation"
        style="@style/TarotTextBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="start|top"
        android:justificationMode="none"
        android:lineHeight="21sp"
        android:textSize="14sp" />
</LinearLayout>
