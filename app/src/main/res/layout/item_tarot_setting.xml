<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_56"
    android:paddingHorizontal="@dimen/dp_16"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground"
    xmlns:tools="http://schemas.android.com/tools"
    tools:visibility="visible"
    tools:theme="@style/TarotThemeLight">
    <com.tarot.card.meaning.tarot.TarotIcon
        android:id="@+id/settingIcon"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        android:background="@drawable/tarot_bg_white_circle"
        app:tarotIconColor="?attr/tarotInk"
        tools:visibility="visible"
        tools:src="@drawable/tarot_ic_settings_star_sign" />
    <LinearLayout
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/dp_12"
        android:orientation="vertical"
        tools:visibility="visible">
        <TextView
            android:id="@+id/settingTitle"
            style="@style/TarotTextBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sp_11"
            tools:visibility="visible"
            tools:text="Star Sign" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_3"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:visibility="visible">
            <TextView
                android:id="@+id/settingValue"
                style="@style/TarotText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                tools:visibility="visible"
                tools:text="Aries" />
            <ImageView
                android:id="@+id/settingZodiacIcon"
                style="@style/TarotZodiacIcon"
                android:layout_width="@dimen/dp_17"
                android:layout_height="@dimen/dp_17"
                android:layout_marginStart="@dimen/dp_2"
                android:importantForAccessibility="no"
                android:visibility="gone"
                tools:visibility="visible"
                tools:src="@drawable/ic_aries" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/settingTrailing"
        style="@style/TarotTextBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_8"
        tools:visibility="visible"
        tools:text="English (US)" />
    <ImageView
        android:id="@+id/settingChevron"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:scaleType="centerInside"
        android:src="@drawable/ic_arrow_settings"
        android:importantForAccessibility="no"
        tools:visibility="visible"
        tools:src="@drawable/ic_arrow_settings" />
</LinearLayout>
