<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/tarot_bg_spread"
    android:clipToOutline="true"
    android:clickable="true"
    android:focusable="true">
    <ImageView
        android:id="@+id/spreadBackground"
        android:layout_width="90dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/spreadLockBadge"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <ImageView
            android:id="@+id/spreadIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/spreadTitle"
                style="@style/TarotTextHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_bold"
                android:textSize="15sp"
                android:lineHeight="20sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/tarot_green" />
            <TextView
                android:id="@+id/spreadDescription"
                style="@style/TarotTextBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:lineHeight="16sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <!-- Dim the artwork and text together, but preserve the outer 1dp border. -->
    <View
        android:id="@+id/spreadLockOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="1dp"
        android:background="@drawable/tarot_spread_locked_overlay"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
    <!-- Draw after the overlay so the lock and countdown remain fully legible. -->
    <LinearLayout
        android:id="@+id/spreadLockBadge"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginEnd="12dp"
        android:paddingHorizontal="4dp"
        android:background="@drawable/tarot_bg_spread_lock"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <ImageView
            android:id="@+id/spreadLockIcon"
            android:layout_width="12dp"
            android:layout_height="14dp"
            android:src="@drawable/tarot_ic_spread_lock"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/spreadLock"
            style="@style/TarotTextHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/nunito_bold"
            android:gravity="center"
            android:textColor="@color/tarot_green"
            android:textSize="12sp"
            android:lineHeight="16sp"
            android:maxLines="1" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
