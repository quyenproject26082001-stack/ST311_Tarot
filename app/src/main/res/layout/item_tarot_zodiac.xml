<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/dp_0"
    android:layout_height="@dimen/dp_80"
    android:layout_columnWeight="1"
    android:layout_margin="@dimen/dp_4"
    android:paddingStart="@dimen/dp_5"
    android:paddingEnd="@dimen/dp_5"
    android:paddingTop="@dimen/dp_4_5"
    android:paddingBottom="@dimen/dp_5_5"
    android:gravity="center"
    android:background="@drawable/tarot_bg_zodiac"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true"
    xmlns:tools="http://schemas.android.com/tools"
    tools:layout_width="@dimen/dp_104"
    tools:visibility="visible"
    tools:theme="@style/TarotThemeLight">
    <ImageView
        android:id="@+id/zodiacIcon"
        style="@style/TarotZodiacIcon"
        android:layout_width="@dimen/dp_26"
        android:layout_height="@dimen/dp_26"
        android:importantForAccessibility="no"
        tools:src="@drawable/ic_aries"
        tools:visibility="visible" />
    <TextView
        android:id="@+id/zodiacName"
        style="@style/TarotTextBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_2_5"
        android:lineHeight="@dimen/sp_16"
        android:textSize="@dimen/sp_12"
        tools:visibility="visible"
        tools:text="Aries" />
    <TextView
        android:id="@+id/zodiacDates"
        style="@style/TarotTextBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_1"
        android:lineHeight="@dimen/sp_16"
        android:textSize="@dimen/sp_10"
        tools:visibility="visible"
        tools:text="Mar 21 - Apr 19" />
</LinearLayout>
