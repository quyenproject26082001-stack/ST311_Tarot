<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:visibility="visible"
    tools:theme="@style/TarotThemeLight"
    tools:ignore="UnusedResources">
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_16"
        android:scrollbars="none"
        tools:visibility="visible">
        <LinearLayout
            android:id="@+id/categories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/dp_12"
            android:paddingBottom="@dimen/dp_16"
            android:orientation="horizontal"
            tools:visibility="visible">
            <TextView
                style="@style/TarotText"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_35"
                android:layout_marginEnd="@dimen/dp_8"
                android:paddingHorizontal="@dimen/dp_16"
                android:gravity="center"
                android:fontFamily="@font/tarot_nunito_semibold"
                android:lineHeight="@dimen/sp_18"
                android:background="@drawable/tarot_bg_outline"
                android:textColor="@color/tarot_gold"
                android:clickable="true"
                android:focusable="true"
                tools:visibility="visible"
                tools:text="All Cards"
                tools:theme="@style/TarotThemeLight" />
            <TextView
                style="@style/TarotText"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_35"
                android:layout_marginEnd="@dimen/dp_8"
                android:paddingHorizontal="@dimen/dp_16"
                android:gravity="center"
                android:fontFamily="@font/tarot_nunito_semibold"
                android:lineHeight="@dimen/sp_18"
                android:background="@drawable/tarot_bg_outline"
                android:textColor="@color/tarot_gold"
                android:clickable="true"
                android:focusable="true"
                tools:visibility="visible"
                tools:text="Major Arcana"
                tools:theme="@style/TarotThemeLight" />
            <TextView
                style="@style/TarotText"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_35"
                android:layout_marginEnd="@dimen/dp_8"
                android:paddingHorizontal="@dimen/dp_16"
                android:gravity="center"
                android:fontFamily="@font/tarot_nunito_semibold"
                android:lineHeight="@dimen/sp_18"
                android:background="@drawable/tarot_bg_outline"
                android:textColor="@color/tarot_gold"
                android:clickable="true"
                android:focusable="true"
                tools:visibility="visible"
                tools:text="Wands"
                tools:theme="@style/TarotThemeLight" />
            <TextView
                style="@style/TarotText"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_35"
                android:layout_marginEnd="@dimen/dp_8"
                android:paddingHorizontal="@dimen/dp_16"
                android:gravity="center"
                android:fontFamily="@font/tarot_nunito_semibold"
                android:lineHeight="@dimen/sp_18"
                android:background="@drawable/tarot_bg_outline"
                android:textColor="@color/tarot_gold"
                android:clickable="true"
                android:focusable="true"
                tools:visibility="visible"
                tools:text="Cups"
                tools:theme="@style/TarotThemeLight" />
            <TextView
                style="@style/TarotText"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_35"
                android:layout_marginEnd="@dimen/dp_8"
                android:paddingHorizontal="@dimen/dp_16"
                android:gravity="center"
                android:fontFamily="@font/tarot_nunito_semibold"
                android:lineHeight="@dimen/sp_18"
                android:background="@drawable/tarot_bg_outline"
                android:textColor="@color/tarot_gold"
                android:clickable="true"
                android:focusable="true"
                tools:visibility="visible"
                tools:text="Swords"
                tools:theme="@style/TarotThemeLight" />
            <TextView
                style="@style/TarotText"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_35"
                android:layout_marginEnd="@dimen/dp_8"
                android:paddingHorizontal="@dimen/dp_16"
                android:gravity="center"
                android:fontFamily="@font/tarot_nunito_semibold"
                android:lineHeight="@dimen/sp_18"
                android:background="@drawable/tarot_bg_outline"
                android:textColor="@color/tarot_gold"
                android:clickable="true"
                android:focusable="true"
                tools:visibility="visible"
                tools:text="Pentacles"
                tools:theme="@style/TarotThemeLight" />
        </LinearLayout>
    </HorizontalScrollView>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/cards"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/dp_12"
        android:paddingTop="@dimen/dp_4"
        android:paddingBottom="@dimen/dp_12"
        android:clipToPadding="false"
        tools:visibility="visible"
        tools:listitem="@layout/item_tarot_library_grid"
        tools:itemCount="9"
        tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        tools:spanCount="3" />
</LinearLayout>
