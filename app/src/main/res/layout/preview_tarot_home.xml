<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:visibility="visible"
    tools:ignore="UnusedResources">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_minus_3"
        android:orientation="vertical"
        tools:visibility="visible"
        tools:theme="@style/TarotThemeLight"
        android:paddingHorizontal="@dimen/dp_16">
        <TextView
            android:id="@+id/greeting"
            style="@style/TarotTextHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/tarot_nunito_medium"
            tools:visibility="visible"
            tools:text="Hello, Seraphina!" />
        <TextView
            style="@style/TarotTextBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_minus_1_5"
            android:textSize="@dimen/sp_13"
            android:lineHeight="@dimen/sp_18"
            android:text="@string/tarot_discover"
            tools:visibility="visible"
            tools:text="@string/tarot_discover" />
        <FrameLayout
            android:id="@+id/horoscope"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_200"
            android:layout_marginTop="@dimen/dp_13_5"
            android:background="@drawable/tarot_bg_horoscope"
            android:clipToOutline="true"
            android:clickable="true"
            android:focusable="true"
            tools:visibility="visible">
            <ImageView
                android:layout_width="@dimen/dp_102"
                android:layout_height="@dimen/dp_62"
                android:layout_gravity="bottom|start"
                android:src="@drawable/tarot_horoscope_sun"
                android:scaleType="fitXY"
                android:importantForAccessibility="no"
                tools:visibility="visible"
                tools:src="@drawable/tarot_horoscope_sun" />
            <ImageView
                android:layout_width="@dimen/dp_39"
                android:layout_height="@dimen/dp_38"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/dp_4"
                android:src="@drawable/tarot_horoscope_moon"
                android:scaleType="fitXY"
                android:importantForAccessibility="no"
                tools:visibility="visible"
                tools:src="@drawable/tarot_horoscope_moon" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/dp_12"
                android:orientation="vertical"
                tools:visibility="visible">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_23"
                    android:paddingHorizontal="@dimen/dp_6"
                    android:gravity="center_vertical"
                    android:background="@drawable/tarot_bg_outline"
                    android:orientation="horizontal"
                    tools:visibility="visible">
                    <ImageView
                        android:id="@+id/zodiacIcon"
                        style="@style/TarotZodiacBadgeIcon"
                        android:layout_width="@dimen/dp_16"
                        android:layout_height="@dimen/dp_16"
                        android:importantForAccessibility="no"
                        tools:visibility="visible"
                        tools:src="@drawable/ic_aries" />
                    <TextView
                        android:id="@+id/zodiacName"
                        style="@style/TarotText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_5"
                        android:textColor="@color/tarot_gold"
                        android:textSize="@dimen/sp_12"
                        tools:visibility="visible"
                        tools:text="Aries" />
                </LinearLayout>
                <TextView
                    style="@style/TarotTextHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:text="@string/tarot_weekly_horoscope"
                    tools:visibility="visible"
                    tools:text="@string/tarot_weekly_horoscope" />
                <TextView
                    android:id="@+id/horoscopeSummary"
                    style="@style/TarotTextBody"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/dp_8"
                    android:textStyle="italic"
                    android:text="@string/tarot_home_horoscope_preview"
                    tools:visibility="visible"
                    tools:text="@string/tarot_home_horoscope_preview" />
                <TextView
                    style="@style/TarotTextHeading"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_32"
                    android:gravity="end|center_vertical"
                    android:textSize="@dimen/sp_14"
                    android:text="@string/tarot_view_horoscope"
                    tools:visibility="visible"
                    tools:text="@string/tarot_view_horoscope" />
            </LinearLayout>
        </FrameLayout>
        <TextView
            style="@style/TarotTextHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:fontFamily="@font/tarot_nunito_semibold"
            android:text="@string/tarot_quick_actions"
            tools:visibility="visible"
            tools:text="@string/tarot_quick_actions" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/quickActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6_5"
            tools:visibility="visible">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/actionDaily"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_0"
                android:clickable="true"
                android:focusable="true"
                tools:visibility="visible"
                tools:theme="@style/TarotThemeLight"
                android:layout_marginEnd="@dimen/dp_12"
                app:layout_constraintDimensionRatio="H,99:122.5"
                app:layout_constraintEnd_toStartOf="@id/actionWeekly"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/actionArt_action0"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_0"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="visible"
                    tools:src="@drawable/tarot_action_daily" />
                <TextView
                    android:id="@+id/actionTitle_action0"
                    style="@style/TarotText1"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_30"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:textSize="@dimen/sp_12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.92"
                    tools:visibility="visible"
                    tools:text="Daily Reading"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/actionWeekly"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_0"
                android:clickable="true"
                android:focusable="true"
                tools:visibility="visible"
                tools:theme="@style/TarotThemeLight"
                android:layout_marginEnd="@dimen/dp_12"
                app:layout_constraintDimensionRatio="H,99:122.5"
                app:layout_constraintEnd_toStartOf="@id/actionCeltic"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@id/actionDaily"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/actionArt_action1"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_0"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="visible"
                    tools:src="@drawable/tarot_action_weekly" />
                <TextView
                    android:id="@+id/actionTitle_action1"
                    style="@style/TarotText1"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_30"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:textSize="@dimen/sp_12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.92"
                    tools:visibility="visible"
                    tools:text="Weekly Reading"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/actionCeltic"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_0"
                android:clickable="true"
                android:focusable="true"
                tools:visibility="visible"
                tools:theme="@style/TarotThemeLight"
                app:layout_constraintDimensionRatio="H,99:122.5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@id/actionWeekly"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/actionArt_action2"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_0"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="visible"
                    tools:src="@drawable/tarot_action_celtic" />
                <TextView
                    android:id="@+id/actionTitle_action2"
                    style="@style/TarotText1"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_30"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:textSize="@dimen/sp_12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.92"
                    tools:visibility="visible"
                    tools:text="Celtic Cross"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            style="@style/TarotTextHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_15"
            android:text="@string/tarot_recent"
            tools:visibility="visible"
            tools:text="@string/tarot_recent" />
        <LinearLayout
            android:id="@+id/recentReadings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:orientation="vertical"
            tools:visibility="visible">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_108"
                android:layout_marginBottom="@dimen/dp_12"
                android:background="@drawable/tarot_bg_panel"
                android:clickable="true"
                android:focusable="true"
                tools:visibility="visible"
                tools:theme="@style/TarotThemeLight">
                <FrameLayout
                    android:id="@+id/thumbnailHost_reading0"
                    android:layout_width="@dimen/dp_99"
                    android:layout_height="@dimen/dp_98"
                    android:layout_marginStart="@dimen/dp_12"
                    android:layout_marginTop="@dimen/dp_5"
                    tools:visibility="visible">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        tools:src="@drawable/tarot_deck_back"
                        tools:visibility="visible" />
                </FrameLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_116"
                    android:layout_marginEnd="@dimen/dp_12"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    tools:visibility="visible">
                    <TextView
                        android:id="@+id/readingTitle_reading0"
                        style="@style/TarotText"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_22"
                        android:paddingEnd="@dimen/dp_48"
                        android:gravity="center_vertical"
                        android:fontFamily="@font/tarot_nunito_medium"
                        android:textSize="@dimen/sp_16"
                        android:lineHeight="@dimen/sp_20"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:visibility="visible"
                        tools:text="Daily Reading" />
                    <TextView
                        android:id="@+id/readingDate_reading0"
                        style="@style/TarotTextBody"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_14"
                        android:layout_marginTop="@dimen/dp_2"
                        android:gravity="center_vertical"
                        android:textSize="@dimen/sp_10"
                        android:lineHeight="@dimen/sp_14"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:visibility="visible"
                        tools:text="21 Oct 2026" />
                    <TextView
                        android:id="@+id/readingSummary_reading0"
                        style="@style/TarotText"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_18"
                        android:layout_marginTop="@dimen/dp_8"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="@dimen/sp_12"
                        android:lineHeight="@dimen/sp_16"
                        tools:visibility="visible"
                        tools:text="Page of Wands · Upright" />
                </LinearLayout>
                <com.tarot.card.meaning.tarot.TarotIcon
                    android:id="@+id/favorite_reading0"
                    android:padding="@dimen/dp_11"
                    android:background="@drawable/tarot_bg_favorite"
                    android:layout_width="@dimen/dp_40"
                    android:layout_height="@dimen/dp_40"
                    android:layout_marginTop="@dimen/dp_15"
                    android:layout_marginEnd="@dimen/dp_12"
                    android:layout_gravity="top|end"
                    app:tarotIconName="heart"
                    app:tarotIconColor="?attr/tarotMuted"
                    android:contentDescription="@string/tarot_favorite"
                    tools:visibility="visible"
                    tools:src="@drawable/tarot_ic_heart" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
