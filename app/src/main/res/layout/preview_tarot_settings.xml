<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:visibility="visible"
    tools:ignore="UnusedResources">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:visibility="visible"
        tools:theme="@style/TarotThemeLight"
        android:padding="@dimen/dp_16">
        <TextView
            style="@style/TarotText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp_4"
            android:textSize="@dimen/sp_11"
            android:text="@string/tarot_personal_information"
            tools:visibility="visible"
            tools:text="@string/tarot_personal_information" />
        <LinearLayout
            android:id="@+id/personalGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:background="@drawable/tarot_settings_panel"
            android:clipToOutline="true"
            android:orientation="vertical"
            tools:visibility="visible">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_56"
                android:paddingHorizontal="@dimen/dp_16"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                tools:visibility="visible"
                tools:theme="@style/TarotThemeLight">
                <com.tarot.card.meaning.tarot.TarotIcon
                    android:id="@+id/settingIcon_personal0"
                    android:layout_width="@dimen/dp_32"
                    android:layout_height="@dimen/dp_32"
                    android:background="@drawable/tarot_bg_white_circle"
                    app:tarotIconColor="?attr/tarotInk"
                    tools:visibility="visible"
                    tools:src="@drawable/tarot_ic_name" />
                <LinearLayout
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_12"
                    android:orientation="vertical"
                    tools:visibility="visible">
                    <TextView
                        android:id="@+id/settingTitle_personal0"
                        style="@style/TarotTextBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_11"
                        tools:visibility="visible"
                        tools:text="@string/tarot_name" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_3"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        tools:visibility="visible">
                        <TextView
                            android:id="@+id/settingValue_personal0"
                            style="@style/TarotText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            tools:visibility="visible"
                            tools:text="Seraphina" />
                    </LinearLayout>
                </LinearLayout>
                <ImageView
                    android:id="@+id/settingChevron_personal0"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_arrow_settings"
                    android:importantForAccessibility="no"
                    tools:visibility="visible"
                    tools:src="@drawable/ic_arrow_settings" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0_5"
                android:background="?attr/tarotSettingsDivider"
                tools:visibility="visible"
                tools:theme="@style/TarotThemeLight" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_56"
                android:paddingHorizontal="@dimen/dp_16"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                tools:visibility="visible"
                tools:theme="@style/TarotThemeLight">
                <com.tarot.card.meaning.tarot.TarotIcon
                    android:id="@+id/settingIcon_personal1"
                    android:layout_width="@dimen/dp_32"
                    android:layout_height="@dimen/dp_32"
                    android:background="@drawable/tarot_bg_white_circle"
                    app:tarotIconColor="?attr/tarotInk"
                    tools:visibility="visible"
                    tools:src="@drawable/tarot_ic_birthday" />
                <LinearLayout
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_12"
                    android:orientation="vertical"
                    tools:visibility="visible">
                    <TextView
                        android:id="@+id/settingTitle_personal1"
                        style="@style/TarotTextBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_11"
                        tools:visibility="visible"
                        tools:text="@string/tarot_birthday" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_3"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        tools:visibility="visible">
                        <TextView
                            android:id="@+id/settingValue_personal1"
                            style="@style/TarotText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            tools:visibility="visible"
                            tools:text="08/04/2000" />
                    </LinearLayout>
                </LinearLayout>
                <ImageView
                    android:id="@+id/settingChevron_personal1"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_arrow_settings"
                    android:importantForAccessibility="no"
                    tools:visibility="visible"
                    tools:src="@drawable/ic_arrow_settings" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0_5"
                android:background="?attr/tarotSettingsDivider"
                tools:visibility="visible"
                tools:theme="@style/TarotThemeLight" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_56"
                android:paddingHorizontal="@dimen/dp_16"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                tools:visibility="visible"
                tools:theme="@style/TarotThemeLight">
                <com.tarot.card.meaning.tarot.TarotIcon
                    android:id="@+id/settingIcon_personal2"
                    android:layout_width="@dimen/dp_32"
                    android:layout_height="@dimen/dp_32"
                    android:background="@drawable/tarot_bg_white_circle"
                    app:tarotIconColor="?attr/tarotInk"
                    tools:visibility="visible"
                    tools:src="@drawable/tarot_ic_privacy" />
                <LinearLayout
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_12"
                    android:orientation="vertical"
                    tools:visibility="visible">
                    <TextView
                        android:id="@+id/settingTitle_personal2"
                        style="@style/TarotTextBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_11"
                        tools:visibility="visible"
                        tools:text="@string/tarot_zodiac" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_3"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        tools:visibility="visible">
                        <TextView
                            android:id="@+id/settingValue_personal2"
                            style="@style/TarotText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            tools:visibility="visible"
                            tools:text="Aries" />
                        <ImageView
                            android:id="@+id/settingZodiacIcon_personal2"
                            style="@style/TarotZodiacIcon"
                            android:layout_width="@dimen/dp_17"
                            android:layout_height="@dimen/dp_17"
                            android:layout_marginStart="@dimen/dp_2"
                            android:importantForAccessibility="no"
                            android:visibility="gone"
                            tools:visibility="visible"
                            tools:src="@drawable/ic_aries" />
                    </LinearLayout>
                </LinearLayout>
                <ImageView
                    android:id="@+id/settingChevron_personal2"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_arrow_settings"
                    android:importantForAccessibility="no"
                    tools:visibility="visible"
                    tools:src="@drawable/ic_arrow_settings" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56"
            android:layout_marginTop="@dimen/dp_16"
            android:background="@drawable/tarot_settings_panel"
            android:paddingHorizontal="@dimen/dp_16"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:visibility="visible">
            <TextView
                style="@style/TarotText"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tarot_theme"
                tools:visibility="visible"
                tools:text="@string/tarot_theme" />
            <LinearLayout
                android:layout_width="@dimen/dp_144"
                android:layout_height="@dimen/dp_34"
                android:padding="@dimen/dp_4"
                android:background="@drawable/tarot_settings_theme_background"
                android:orientation="horizontal"
                tools:visibility="visible">
                <TextView
                    android:id="@+id/lightTheme"
                    android:drawableStart="@drawable/tarot_ic_light_small"
                    android:drawablePadding="@dimen/dp_3"
                    android:drawableTint="@color/tarot_theme_choice"
                    android:paddingHorizontal="@dimen/dp_6"
                    style="@style/TarotText"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textSize="@dimen/sp_12"
                    android:text="@string/tarot_light"
                    tools:visibility="visible"
                    tools:text="@string/tarot_light" />
                <TextView
                    android:id="@+id/darkTheme"
                    android:drawableStart="@drawable/tarot_ic_dark_small"
                    android:drawablePadding="@dimen/dp_3"
                    android:drawableTint="@color/tarot_theme_choice"
                    android:paddingHorizontal="@dimen/dp_8"
                    style="@style/TarotText"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textSize="@dimen/sp_12"
                    android:text="@string/tarot_dark"
                    tools:visibility="visible"
                    tools:text="@string/tarot_dark" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56"
            android:layout_marginTop="@dimen/dp_16"
            android:background="@drawable/tarot_settings_panel"
            android:paddingHorizontal="@dimen/dp_20"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:visibility="visible">
            <TextView
                style="@style/TarotText"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tarot_show_guidance"
                tools:visibility="visible"
                tools:text="@string/tarot_show_guidance" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/guidanceToggle"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_20"
                android:minWidth="@dimen/dp_0"
                android:minHeight="@dimen/dp_0"
                android:padding="@dimen/dp_0"
                android:background="@drawable/tarot_settings_guidance_toggle"
                android:thumb="@null"
                app:track="@null"
                app:switchMinWidth="@dimen/dp_0"
                app:showText="false"
                app:thumbTint="@null"
                app:trackTint="@null"
                android:contentDescription="@string/tarot_show_guidance"
                tools:visibility="visible"
                tools:text="Show guidance"
                tools:checked="true" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_72"
            android:layout_marginTop="@dimen/dp_16"
            android:background="@drawable/tarot_settings_panel"
            android:paddingHorizontal="@dimen/dp_20"
            android:paddingTop="@dimen/dp_12"
            android:orientation="vertical"
            tools:visibility="visible">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                tools:visibility="visible">
                <TextView
                    style="@style/TarotText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tarot_reverse_chance"
                    tools:visibility="visible"
                    tools:text="@string/tarot_reverse_chance" />
                <com.tarot.card.meaning.tarot.TarotIcon
                    android:id="@+id/reverseInfo"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    app:tarotIconName="info"
                    app:tarotIconColor="?attr/tarotMuted"
                    android:contentDescription="@string/tarot_reverse_chance"
                    tools:visibility="visible"
                    tools:src="@drawable/tarot_ic_info" />
                <TextView
                    android:id="@+id/reversePercent"
                    style="@style/TarotText"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textSize="@dimen/sp_12"
                    tools:visibility="visible"
                    tools:text="50%" />
            </LinearLayout>
            <SeekBar
                android:id="@+id/reverseChance"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_32"
                android:max="100"
                android:progressDrawable="@drawable/tarot_seek_track"
                android:thumb="@drawable/tarot_seek_thumb"
                android:splitTrack="false"
                android:maxHeight="@dimen/dp_8"
                android:minHeight="@dimen/dp_8"
                android:progressTint="?attr/tarotSettingsAccent"
                android:thumbTint="?attr/tarotSettingsAccent"
                android:progressBackgroundTint="@color/tarot_disabled"
                android:paddingHorizontal="@dimen/dp_0"
                android:contentDescription="@string/tarot_reverse_chance"
                tools:visibility="visible"
                tools:progress="50" />
        </LinearLayout>
        <TextView
            style="@style/TarotText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:paddingStart="@dimen/dp_4"
            android:textSize="@dimen/sp_11"
            android:text="@string/tarot_additional_options"
            tools:visibility="visible"
            tools:text="@string/tarot_additional_options" />
        <LinearLayout
            android:id="@+id/additionalGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:background="@drawable/tarot_settings_panel"
            android:clipToOutline="true"
            android:orientation="vertical"
            tools:visibility="visible">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:paddingHorizontal="@dimen/dp_16"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                tools:visibility="visible"
                tools:theme="@style/TarotThemeLight">
                <com.tarot.card.meaning.tarot.TarotIcon
                    android:id="@+id/settingIcon_additional0"
                    android:layout_width="@dimen/dp_32"
                    android:layout_height="@dimen/dp_32"
                    android:background="@drawable/tarot_bg_white_circle"
                    app:tarotIconColor="?attr/tarotInk"
                    tools:visibility="visible"
                    tools:src="@drawable/tarot_ic_share" />
                <LinearLayout
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_12"
                    android:orientation="vertical"
                    tools:visibility="visible">
                    <TextView
                        android:id="@+id/settingTitle_additional0"
                        style="@style/TarotTextBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_14"
                        tools:visibility="visible"
                        tools:text="@string/tarot_privacy" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_3"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        tools:visibility="visible">
            </LinearLayout>
                </LinearLayout>
                <ImageView
                    android:id="@+id/settingChevron_additional0"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_arrow_settings"
                    android:importantForAccessibility="no"
                    tools:visibility="visible"
                    tools:src="@drawable/ic_arrow_settings" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0_5"
                android:background="?attr/tarotSettingsDivider"
                tools:visibility="visible"
                tools:theme="@style/TarotThemeLight" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:paddingHorizontal="@dimen/dp_16"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                tools:visibility="visible"
                tools:theme="@style/TarotThemeLight">
                <com.tarot.card.meaning.tarot.TarotIcon
                    android:id="@+id/settingIcon_additional1"
                    android:layout_width="@dimen/dp_32"
                    android:layout_height="@dimen/dp_32"
                    android:background="@drawable/tarot_bg_white_circle"
                    app:tarotIconColor="?attr/tarotInk"
                    tools:visibility="visible"
                    tools:src="@drawable/tarot_ic_language" />
                <LinearLayout
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_12"
                    android:orientation="vertical"
                    tools:visibility="visible">
                    <TextView
                        android:id="@+id/settingTitle_additional1"
                        style="@style/TarotTextBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_14"
                        tools:visibility="visible"
                        tools:text="@string/tarot_share" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_3"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        tools:visibility="visible">
            </LinearLayout>
                </LinearLayout>
                <ImageView
                    android:id="@+id/settingChevron_additional1"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_arrow_settings"
                    android:importantForAccessibility="no"
                    tools:visibility="visible"
                    tools:src="@drawable/ic_arrow_settings" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0_5"
                android:background="?attr/tarotSettingsDivider"
                tools:visibility="visible"
                tools:theme="@style/TarotThemeLight" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:paddingHorizontal="@dimen/dp_16"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                tools:visibility="visible"
                tools:theme="@style/TarotThemeLight">
                <com.tarot.card.meaning.tarot.TarotIcon
                    android:id="@+id/settingIcon_additional2"
                    android:layout_width="@dimen/dp_32"
                    android:layout_height="@dimen/dp_32"
                    android:background="@drawable/tarot_bg_white_circle"
                    app:tarotIconColor="?attr/tarotInk"
                    tools:visibility="visible"
                    tools:src="@drawable/tarot_ic_settings_star_sign" />
                <LinearLayout
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_12"
                    android:orientation="vertical"
                    tools:visibility="visible">
                    <TextView
                        android:id="@+id/settingTitle_additional2"
                        style="@style/TarotTextBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_14"
                        tools:visibility="visible"
                        tools:text="@string/tarot_language" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_3"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        tools:visibility="visible">
            </LinearLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/settingTrailing_additional2"
                    style="@style/TarotTextBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/dp_8"
                    tools:visibility="visible"
                    tools:text="English (US)" />
                <ImageView
                    android:id="@+id/settingChevron_additional2"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_arrow_settings"
                    android:importantForAccessibility="no"
                    tools:visibility="visible"
                    tools:src="@drawable/ic_arrow_settings" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
