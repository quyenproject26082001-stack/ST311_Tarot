<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:padding="@dimen/dp_20"
    tools:visibility="visible"
    tools:theme="@style/TarotThemeLight"
    tools:ignore="UnusedResources">
    <ScrollView
        android:id="@+id/dialogScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="?attr/tarotSettingsOverlayBackground"
        android:clipToOutline="true"
        android:fillViewport="false"
        android:scrollbars="none"
        tools:visibility="visible">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dp_16"
            android:paddingTop="@dimen/dp_24"
            android:paddingBottom="@dimen/dp_28"
            android:orientation="vertical"
            tools:visibility="visible"
            tools:theme="@style/TarotThemeLight">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_32"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                tools:visibility="visible">
                <TextView
                    android:id="@+id/sheetTitle"
                    style="@style/TarotTextHeading"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="@dimen/sp_16"
                    tools:visibility="visible"
                    tools:text="@string/tarot_edit_name" />
                <com.tarot.card.meaning.tarot.TarotIcon
                    android:id="@+id/close"
                    style="@style/TarotIconButton"
                    android:layout_marginEnd="@dimen/dp_minus_4"
                    android:layout_width="@dimen/dp_32"
                    android:layout_height="@dimen/dp_32"
                    android:padding="@dimen/dp_8"
                    app:tarotIconName="close"
                    app:tarotIconColor="?attr/tarotInk"
                    android:contentDescription="@string/tarot_close"
                    tools:visibility="visible"
                    tools:src="@drawable/tarot_ic_close" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/sheetContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:orientation="vertical"
                tools:visibility="visible">
                <include
                    layout="@layout/dialog_tarot_edit_name"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
