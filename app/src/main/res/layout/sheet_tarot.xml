<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingTop="24dp"
    android:paddingBottom="28dp"
    android:background="@drawable/tarot_bg_sheet"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/sheetTitle"
            style="@style/TarotTextHeading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp" />
        <com.aaa.bbb.ccc.tarot.TarotIcon
            android:id="@+id/close"
            style="@style/TarotIconButton"
            android:layout_marginEnd="-4dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="8dp"
            app:tarotIconName="close"
            app:tarotIconColor="?attr/tarotInk"
            android:contentDescription="@string/tarot_close" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/sheetContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical" />
</LinearLayout>
