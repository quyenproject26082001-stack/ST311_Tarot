<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp_16"
    android:paddingTop="@dimen/dp_24"
    android:paddingBottom="@dimen/dp_28"
    android:background="@drawable/tarot_bg_sheet"
    android:orientation="vertical"
    xmlns:tools="http://schemas.android.com/tools"
    tools:visibility="visible"
    tools:theme="@style/TarotThemeLight">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_32"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        tools:visibility="visible">
        <TextView
            android:id="@+id/sheetTitle"
            style="@style/TarotTextHeading"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="@dimen/sp_16"
            tools:visibility="visible"
            tools:text="Select Star Sign" />
        <com.tarot.card.meaning.tarot.TarotIcon
            android:id="@+id/close"
            style="@style/TarotIconButton"
            android:layout_marginEnd="@dimen/dp_minus_4"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:padding="@dimen/dp_8"
            app:tarotIconName="close"
            app:tarotIconColor="?attr/tarotInk"
            android:contentDescription="@string/tarot_close"
            tools:visibility="visible"
            tools:src="@drawable/tarot_ic_close" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/sheetContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:orientation="vertical"
        tools:visibility="visible" />
</LinearLayout>
