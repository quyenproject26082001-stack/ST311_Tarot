<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/dp_79"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    xmlns:tools="http://schemas.android.com/tools"
    tools:visibility="visible"
    tools:theme="@style/TarotThemeLight">
    <ImageView
        android:id="@+id/emptyHistoryArt"
        android:layout_width="@dimen/dp_200"
        android:layout_height="@dimen/dp_185"
        android:background="?attr/tarotEmptyHistoryGlow"
        android:src="?attr/tarotEmptyHistoryArt"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no"
        tools:visibility="visible"
        tools:src="@drawable/tarot_empty_history" />
    <TextView
        style="@style/TarotTextHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_45"
        android:gravity="center"
        android:textSize="@dimen/sp_22"
        android:lineHeight="@dimen/sp_28"
        android:text="@string/tarot_no_history"
        tools:visibility="visible"
        tools:text="@string/tarot_no_history" />
    <TextView
        style="@style/TarotTextBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginHorizontal="@dimen/dp_20"
        android:gravity="center"
        android:textSize="@dimen/sp_15"
        android:lineHeight="@dimen/sp_23"
        android:text="@string/tarot_history_description"
        tools:visibility="visible"
        tools:text="@string/tarot_history_description" />
    <TextView
        android:id="@+id/beginReading"
        style="@style/TarotButton"
        android:layout_marginTop="@dimen/dp_20"
        android:fontFamily="@font/nunito_bold"
        android:lineHeight="@dimen/sp_20"
        android:text="@string/tarot_begin"
        tools:visibility="visible"
        tools:text="@string/tarot_begin" />
</LinearLayout>
