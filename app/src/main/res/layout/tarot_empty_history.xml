<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="79dp"
    android:gravity="center_horizontal"
    android:orientation="vertical">
    <ImageView
        android:layout_width="200dp"
        android:layout_height="185dp"
        android:src="@drawable/tarot_empty_history"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />
    <TextView
        style="@style/TarotTextHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="45dp"
        android:gravity="center"
        android:textSize="22sp"
        android:lineHeight="28sp"
        android:text="@string/tarot_no_history" />
    <TextView
        style="@style/TarotTextBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="20dp"
        android:gravity="center"
        android:textSize="15sp"
        android:lineHeight="23sp"
        android:text="@string/tarot_history_description" />
    <TextView
        android:id="@+id/beginReading"
        style="@style/TarotButton"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/nunito_bold"
        android:lineHeight="20sp"
        android:text="@string/tarot_begin" />
</LinearLayout>
