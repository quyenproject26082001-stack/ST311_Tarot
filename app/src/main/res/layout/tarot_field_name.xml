<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:gravity="top">
    <com.aaa.bbb.ccc.tarot.TarotIcon
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/tarot_bg_badge"
        app:tarotIconName="name"
        app:tarotIconColor="?attr/tarotInk" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:orientation="vertical">
        <EditText
            android:id="@+id/nameInput"
            style="@style/TarotText"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/tarot_settings_name_background"
            android:fontFamily="@font/nunito_regular"
            android:includeFontPadding="false"
            android:gravity="center_vertical"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:paddingHorizontal="12dp"
            android:inputType="textPersonName|textCapWords"
            android:singleLine="true"
            android:maxLength="24"
            android:hint="@string/tarot_name"
            android:textColorHint="?attr/tarotMuted" />
        <TextView
            android:id="@+id/nameCounter"
            style="@style/TarotTextBody"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="2dp"
            android:translationY="-2dp"
            android:gravity="end"
            android:lineHeight="10sp"
            android:maxLines="1"
            android:textSize="8sp" />
    </LinearLayout>
</LinearLayout>
