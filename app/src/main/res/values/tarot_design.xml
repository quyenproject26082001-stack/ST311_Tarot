<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Sampled from the 720 px reference boards; layout baseline is 360 dp. -->
    <color name="tarot_gold">#DDBE5C</color>
    <color name="tarot_pale_gold">#F6E9B6</color>
    <color name="tarot_green">#10383A</color>
    <color name="tarot_border">#F8E9BD</color>
    <color name="tarot_disabled">#DDDDDD</color>
    <attr
        name="tarotInk"
        format="color" />
    <attr
        name="tarotMuted"
        format="color" />
    <attr
        name="tarotPaper"
        format="color" />
    <attr
        name="tarotSurface"
        format="color" />
    <attr
        name="tarotInput"
        format="color" />
    <declare-styleable name="TarotIcon">
        <attr
            name="tarotIconName"
            format="string" />
        <attr
            name="tarotIconColor"
            format="color" />
    </declare-styleable>
    <style
        name="TarotThemeLight"
        parent="Theme.BaseProject">
        <item name="tarotInk">#172A2A</item>
        <item name="tarotMuted">#60706D</item>
        <item name="tarotPaper">#FFFFFF</item>
        <item name="tarotSurface">#FCFBF7</item>
        <item name="tarotInput">#FBF9F2</item>
        <item name="android:fontFamily">@font/nunito_regular</item>
        <item name="colorControlActivated">@color/tarot_green</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">?attr/tarotPaper</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
    </style>
    <style
        name="TarotThemeDark"
        parent="TarotThemeLight">
        <item name="tarotInk">#EFF5F3</item>
        <item name="tarotMuted">#B1BEBD</item>
        <item name="tarotPaper">#172829</item>
        <item name="tarotSurface">#223A3B</item>
        <item name="tarotInput">#223A3B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#172829</item>
    </style>
    <!-- Match the colored disc inside the screenshot crop, not the 52px PNG bounds. -->
    <style name="TarotZodiacIcon" parent="">
        <item name="android:background">@drawable/tarot_zodiac_icon_mask</item>
        <item name="android:outlineProvider">background</item>
        <item name="android:clipToOutline">true</item>
        <!-- InsetDrawable must define only the mask, not shrink the image content. -->
        <item name="android:padding">0dp</item>
        <item name="android:scaleType">centerCrop</item>
    </style>
    <style name="TarotZodiacBadgeIcon" parent="TarotZodiacIcon">
        <item name="android:background">@drawable/tarot_zodiac_badge_mask</item>
    </style>
    <style name="TarotHoroscopeZodiacIcon" parent="TarotZodiacIcon">
        <item name="android:background">@drawable/tarot_zodiac_horoscope_mask</item>
    </style>
    <style
        name="TarotText"
        parent="">
        <item name="android:fontFamily">@font/nunito_regular</item>
        <item name="android:textColor">?attr/tarotInk</item>
        <item name="android:textSize">14sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingMultiplier">1</item>
        <item name="android:lineHeight">16sp</item>
    </style>
    <style
        name="TarotTextHeading"
        parent="TarotText">
        <item name="android:fontFamily">@font/tarot_nunito_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:lineHeight">22sp</item>
    </style>
    <style
        name="TarotTextBody"
        parent="TarotText">
        <item name="android:textColor">?attr/tarotMuted</item>
        <item name="android:lineHeight">21sp</item>
    </style>
    <style
        name="TarotButton"
        parent="TarotText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:background">@drawable/tarot_bg_button</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style
        name="TarotIconButton"
        parent="">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>
</resources>
