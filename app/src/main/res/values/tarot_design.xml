        <item name="tarotSettingsOverlayBackground">@drawable/tarot_settings_overlay_panel</item>
        <item name="tarotEmptyHistoryGlow">@null</item>
        <item name="tarotEmptyHistoryArt">@drawable/tarot_empty_history</item>
        <item name="tarotEmptyReadingGlow">@null</item>
        <item name="tarotEmptyReadingArt">@drawable/tarot_empty_history</item>
