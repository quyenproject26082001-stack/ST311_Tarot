    <style name="TarotZodiacIcon" parent="">
        <item name="android:background">@null</item>
        <item name="android:clipToOutline">false</item>
        <item name="android:padding">@dimen/dp_0</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
    <style name="TarotZodiacBadgeIcon" parent="TarotZodiacIcon" />
    <style name="TarotHoroscopeZodiacIcon" parent="TarotZodiacIcon" />
    <style
        name="TarotText"
        parent="">
        <item name="android:fontFamily">@font/nunito_regular</item>
        <item name="android:textColor">?attr/tarotInk</item>
        <item name="android:textSize">@dimen/sp_14</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingMultiplier">1</item>
        <item name="android:lineHeight">@dimen/sp_16</item>
    </style>

    <style
        name="TarotText2"
        parent="">
        <item name="android:fontFamily">@font/tarot_nunito_semibold</item>
        <item name="android:textColor">?attr/tarotInk</item>
        <item name="android:textSize">@dimen/sp_18</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingMultiplier">1</item>
        <item name="android:lineHeight">@dimen/sp_16</item>
    </style>

