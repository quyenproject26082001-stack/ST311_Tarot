        <attr
            name="tarotIconName"
            format="string" />
        <attr
            name="tarotIconColor"
            format="color" />
    </declare-styleable>
    <style
        name="TarotThemeLight"
        parent="Theme.BaseProject">
        <item name="tarotInk">#172A2A</item>
        <item name="tarotMuted">#60706D</item>
        <item name="tarotPaper">#FFFFFF</item>
        <item name="tarotSurface">#FCFBF7</item>
        <item name="tarotInput">#FBF9F2</item>
        <item name="tarotBottomBar">#FFFFFF</item>
        <item name="tarotDialogSurface">#FFFFFF</item>
        <item name="tarotDialogPanel">#FCFBF7</item>
