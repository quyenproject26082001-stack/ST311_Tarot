        <item name="tarotDisabledButton">#363636</item>
        <item name="tarotProfilePrevious">#FFFFFF</item>
        <item name="tarotProfilePreviousText">@color/tarot_green</item>
        <item name="tarotPairSurface">#16676B</item>
        <item name="tarotStepActive">@color/tarot_gold</item>
