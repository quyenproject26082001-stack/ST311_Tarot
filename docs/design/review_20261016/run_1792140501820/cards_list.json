      ],
      "visibility": 0,
      "selected": false,
      "text": "The High Priestess",
      "textSizePx": 36,
      "gravity": 8388659,
      "lineHeightPx": 44,
      "typefaceStyle": 1
    },
    {
      "id": "cardMeaning",
